# Dependencies. Anchored with a leading slash: a bare `node_modules/` only
# matches nested paths when this file sits in a subdirectory of the repository,
# so it silently fails to ignore the top-level one.
/node_modules/

# Scratch state written by the verification tools (job store, uploads).
/.tmp-store/
/.tmp-uploads/
*.tmp

# Editor / OS noise.
.vscode/
.idea/
.DS_Store
Thumbs.db

# `lib/` is NOT ignored: it is the compiled output the harness loads from disk
# (`main`/`exports` in package.json point there), and this profile is installed
# from this directory. `tools/build.mjs` regenerates it from `src/`.
